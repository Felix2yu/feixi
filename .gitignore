# 二进制与本地数据
bin/
*.db
*.db-wal
*.db-shm
data/

# 前端
web/node_modules/
web/dist/
internal/web/dist/*
# 只留一个 .gitkeep：让没跑过 make web 的机器上 //go:embed all:dist 也能编译，
# 又不必把构建产物纳入版本控制（否则每次构建后工作区都是脏的）。
!internal/web/dist/.gitkeep

# 编辑器
.DS_Store
.idea/
.vscode/

# ---- 编辑器 / IDE 本地状态（不进版本库）----
.idea/
.vscode/
.vscode-test/
.history/
.fleet/
*.iml
*.swp
*.swo
*~

# ---- 系统垃圾文件（macOS / Windows / Linux 都会生成）----
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid

# ---- 通用本地缓存 / 测试产物（各仓再按技术栈补充）----
.cache/
.tmp/
.pnpm-store/
*.log
*.test
*.tsbuildinfo
.eslintcache
.stylelintcache
*.o
*.lo
*.la
*.a
*.so
*.dylib
*.dll
*.exe
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 密钥 / 签名文件（绝不入库）----
.env
.env.local
.env.*.local
secrets/
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile

# ---- Swift / Xcode 本地状态 ----
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate

# ---- AI Agent 生成目录（不进版本库，本地保留）----
# 各家 AI 编程工具落盘的会话记忆、规则缓存与索引。规则是目录级：
# 想共享的项目级配置请放 docs/ 或仓库根具名单文件，不要只忽略子目录。
.workbuddy/
.trae/
.trea/
.qoder/
.opencode/
.cursor/
.claude/
.codex/
.gemini/
.continue/
.windsurf/
